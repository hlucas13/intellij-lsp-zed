{
  "name": "intellij-lsp-zed",
  "version": "0.2.2",
  "private": true,
  "description": "IntelliJ IDEA LSP server extension for the Zed editor — Java & Kotlin support",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cargo test",
    "test:wasm": "cargo test --target wasm32-wasip2",
    "build": "cargo build --release --target wasm32-wasip2",
    "lint": "cargo clippy --target wasm32-wasip2 -- -D warnings",
    "fmt": "cargo fmt -- --check",
    "fmt:fix": "cargo fmt --",
    "ci": "npm run fmt && npm run lint && npm run build && npm run test"
  },
  "lint-staged": {
    "*.rs": "bash -c 'cargo fmt -- && cargo clippy -- -D warnings'",
    "*.{md,json,jsonc,css,html}": "prettier --write"
  },
  "keywords": [
    "zed",
    "lsp",
    "intellij",
    "java",
    "kotlin",
    "language-server"
  ],
  "author": "Homero Lucas do Prado",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1"
  }
}
